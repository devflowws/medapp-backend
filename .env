PORT=5000
NODE_ENV=development

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=medapp_db

# JWT Auth
JWT_SECRET=votre_super_secret_jwt_a_remplacer
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Resend Email Service (https://resend.com)
# 1. Crée un compte gratuit sur https://resend.com
# 2. Va dans API Keys → Create API Key
# 3. Colle la clé ci-dessous
RESEND_API_KEY=re_ton_api_key_ici
RESEND_FROM_EMAIL=OrdoLive <onboarding@resend.dev>
